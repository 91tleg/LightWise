# WebSocket URL (API Gateway WebSocket)
# Example: wss://x7zn8xoare.execute-api.us-east-1.amazonaws.com/dev
REACT_APP_WS_URL=

# REST API base URL (API Gateway HTTP API)
# Example: https://wqs4rvx6ed.execute-api.us-east-1.amazonaws.com/dev
REACT_APP_API_BASE=

# Cognito hosted UI
# Example: us-east-1_example.auth.us-east-1.amazoncognito.com
REACT_APP_COGNITO_USER_POOL_ID=
REACT_APP_COGNITO_DOMAIN=
REACT_APP_COGNITO_CLIENT_ID=
# Example: http://localhost:3001/callback
REACT_APP_COGNITO_REDIRECT_URI=
# Example: http://localhost:3001/
REACT_APP_COGNITO_LOGOUT_URI=
# Optional. Space-delimited scopes.
REACT_APP_COGNITO_SCOPES=email openid phone profile

# Demo toggles
REACT_APP_USE_MOCK=false

# Optional
REACT_APP_TENANT_ID=tenant-001
REACT_APP_DEFAULT_STREETLIGHT_ID=LW-00042
