# WebSocket URL (API Gateway WebSocket)
REACT_APP_WS_URL=wss://YOUR_WEBSOCKET_ID.execute-api.YOUR_AWS_REGION.amazonaws.com

# REST API base URL (API Gateway HTTP API)
REACT_APP_API_BASE=https://YOUR_API_ID.execute-api.YOUR_AWS_REGION.amazonaws.com

# Cognito Configuration
REACT_APP_COGNITO_USER_POOL_ID=YOUR_AWS_REGION_YOUR_POOL_ID
REACT_APP_COGNITO_DOMAIN=YOUR_APP_DOMAIN.auth.YOUR_AWS_REGION.amazoncognito.com
REACT_APP_COGNITO_CLIENT_ID=YOUR_COGNITO_APP_CLIENT_ID

# Redirect URIs
REACT_APP_COGNITO_REDIRECT_URI=http://localhost:3000/callback
REACT_APP_COGNITO_LOGOUT_URI=http://localhost:3000/

# Scopes
REACT_APP_COGNITO_SCOPES=email openid phone profile

# Demo & Feature Toggles
REACT_APP_USE_MOCK=false
REACT_APP_TENANT_ID=YOUR_TENANT_ID
REACT_APP_DEFAULT_STREETLIGHT_ID=YOUR_DEFAULT_RESOURCE_ID
