# LightWise env template (SAFE TO COMMIT)
# Copy to apps/web/.env.local for your machine

# WebSocket URL (API Gateway WebSocket)
# Example: wss://x7zn8xoare.execute-api.us-east-1.amazonaws.com/dev
REACT_APP_WS_URL=

# REST API base URL (API Gateway HTTP API)
# Example: https://wqs4rvx6ed.execute-api.us-east-1.amazonaws.com/dev
REACT_APP_API_BASE=

# Demo toggles
REACT_APP_USE_MOCK=false

# Optional
REACT_APP_TENANT_ID=tenant-001
REACT_APP_DEFAULT_STREETLIGHT_ID=LW-00042