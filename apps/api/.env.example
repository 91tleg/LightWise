# =============================
# AWS Configuration
# =============================
AWS_REGION=us-west-2

# Timestream
TS_DATABASE=IoTDatabase
TS_TABLE=DeviceMetrics

# DynamoDB for devices and user mapping
DDB_TABLE_DEVICES=DevicesTable
DDB_TABLE_USERS=UsersTable
DDB_TABLE_TENANTS=TenantsTable
DDB_TABLE_TENANT_USERS=TenantUsersMapping

# WebSocket
WS_ENDPOINT=wss://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# =============================
# Cognito / Auth
# =============================
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_APP_CLIENT_ID=your_app_client_id
AUTH_ENABLED=false # true for cognito

# =============================
# Lambda / Local Testing
# =============================
LAMBDA_STAGE=dev
LOG_LEVEL=INFO
